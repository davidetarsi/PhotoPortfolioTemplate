{
  "name": "il-tuo-portfolio",
  "compatibility_date": "2026-07-07",
  "main": "src/worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "il-tuo-bucket" },
    { "binding": "MESSAGES_BUCKET", "bucket_name": "il-tuo-bucket-messages" }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "il-tuo-team.cloudflareaccess.com",
    "ACCESS_AUD": "incolla-qui-l-aud-della-tua-Access-application",
    "R2_PUBLIC_URL": "https://pub-xxxxxxxx.r2.dev",
    "TURNSTILE_SITEKEY": ""
  }
}
